# x402 (USDC on Base)
X402_ENV=testnet                     # testnet (Base Sepolia) | mainnet (Base)
# X402_PRICE=$45.00                  # optional override; mainnet default is $45.00 (src/lib/pricing.js)
# X402_NETWORK=                      # leave unset on mainnet (defaults to eip155:8453)
STORE_WALLET_ADDRESS=0x...           # receives the USDC
X402_FACILITATOR_URL=                # testnet facilitator
CDP_API_KEY_ID=                      # mainnet only (portal.cdp.coinbase.com)
CDP_API_KEY_SECRET=                  # mainnet only — never commit

# Stripe MPP (card / Link wallet) — only offered when both are set
STRIPE_SECRET_KEY=sk_test_...        # a live key is refused unless X402_ENV=mainnet
STRIPE_PROFILE_ID=profile_test_...   # Stripe profile id = MPP networkId
# MPP_ENABLED=false                  # kill switch

# Shopify
SHOPIFY_STORE_DOMAIN=human-not-required.myshopify.com
SHOPIFY_ADMIN_API_KEY=shpat_...      # Shopify Admin → Settings → Apps → Develop apps → Access token

# Email (Gmail)
EMAIL_FROM=you@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx       # Google Account → Security → App Passwords

# App
PORT=3000
APP_URL=https://YOUR-RAILWAY-URL     # Update after Railway deploy
ADMIN_SECRET=                        # Required: set a strong random secret to protect POST /email/resend/:orderId

# Promo codes (comma-separated, never commit real codes)
PROMO_CODES=HNR-FREE-XXXX,HNR-FREE-YYYY
